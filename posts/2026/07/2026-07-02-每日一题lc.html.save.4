class Solution {
    bool isSameTree(TreeNode* p, TreeNode* q){
        if(!p || !q){
            if(!p && !q)return true;
            else return false;
        }
        else{
            if(q -> val != p -> val)return false;
            else{
                return isSameTree(p -> left, q -> right) && isSameTree(p -> right, q -> left);
