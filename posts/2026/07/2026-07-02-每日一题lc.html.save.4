			<h3>3217.从链表中移除在数组中存在的节点</h3>
			<a href="https://leetcode.cn/problems/delete-nodes-from-linked-list-present-in-array/description/" class="link link-bold" target="_blank" rel="noopener norefferer">3217.从链表中移除在数组中存在的节点</a>
			<p>利用哈希表检验是否在数组，释放裸指针会报错，猜测为LeetCode框架已自主释放</p>
			<pre><code class="language-cpp">
 #include &lt;unordered_set&gt;
class Solution {
public:
    ListNode* modifiedList(vector<int>& nums, ListNode* head) {
        if(!head) return nullptr;
        unordered_set<int> group;
        ListNode dummy(0, head);
        ListNode* cur = &dummy;
        ListNode* nxt;
        for(auto num : nums){
            group.insert(num);
        }
        while(cur -> next){
            if(group.find(cur -> next -> val) != group.end()){
                nxt = cur -> next;
                cur -> next = nxt -> next;
            }
            else{
                cur = cur -> next;
            }
        }
        return dummy.next;
    }
};
			</code></pre>

			<h3>2487.从链表中移除节点</h3>
			<a href="https://leetcode.cn/problems/remove-nodes-from-linked-list/description/" class="link link-bold" target="_blank" rel="noopener noreferrer">2487.从链表中移除节点</a>
			<p>逆序遍历可以用递归解决，更简单</p>
			<pre><code class="language-cpp">
class Solution {
public:
    ListNode* removeNodes(ListNode* head) {
        if(!(head -> next))return head;
        ListNode* nxt = removeNodes(head -> next);
        if(nxt -> val > head -> val){
            return nxt;
        }
        head -> next = nxt;
        return head;
    }
};
			</code></pre>
			
			<h3>1669.合并两个链表</h3>
			<a href="https://leetcode.cn/problems/merge-in-between-linked-lists/description/" class="link link-bold" target="_blank" rel="noopener noreferrer">1669.合并两个链表</a>
			<p>这题只需想清楚边界条件即可</p>
			<pre><code class="language-cpp">
class Solution {
public:
    ListNode* mergeInBetween(ListNode* list1, int a, int b, ListNode* list2) {
        ListNode dummy(0, list1);
        ListNode* cur = &dummy;
        ListNode* temp = cur;
        ListNode* nxt;
        for(int i = 0; i < a; i++){
            temp = temp -> next;
        }
        cur = temp;
        temp = temp -> next;
        for(int i = a; i <= b; i++){
            nxt = temp;
            temp = temp -> next;
            delete nxt;
        }
        cur -> next = list2;
        while(cur -> next){
            cur = cur -> next;
        }
        cur -> next = temp;
        return dummy.next;
    }
};
			</code></pre>
			
