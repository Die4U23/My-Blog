			<h3>1448.统计二叉树中好节点的数目</h3>
			<a href="https://leetcode.cn/problems/count-good-nodes-in-binary-tree/description/" class="link link-bold" target="_blank" rel="noopener noreferrer"> 1448.统计二叉树中好节点的数目</a>
			<p>还是dfs解决</p>
			<pre><code class="language-cpp">
class Solution {
public:
    int goodNodes(TreeNode* root) {
        int ans = 0;
        if(!root)return 0;
        auto dfs = [&](this auto&& dfs, TreeNode* node, int s) -> void{
            if(!node)return;
            if(node -> val >= s){
                ans += 1;
                dfs(node -> left, node -> val);
                dfs(node -> right, node -> val);
            }
            else{
                dfs(node -> left, s);
                dfs(node -> right, s);
            }
        };
        dfs(root, root -> val);
        return ans;
    }
};
