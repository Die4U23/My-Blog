			<h3>110.平衡二叉树</h3>
			<a href="https://leetcode.cn/problems/balanced-binary-tree/" class="link link-bold" target="_blank" rel="noopener noreferrer">110.平衡二叉树</a>
			<p>比较简单，递归注意传递结果即可</p>
			<pre><code class="language-cpp">
class Solution {
    int height(TreeNode* root){
        if(!root)return 0;
        int l = height(root -> left), r = height(root -> right);
        if(l == -1 || r == -1 || abs(l - r) > 1)return -1;
        else return max(l, r) + 1;
    }
public:
    bool isBalanced(TreeNode* root) {
        return height(root) == -1? false: true;
    }
};
			</code></pre>

			<h3>199.二叉树的右视图</h3>
			<a href="https://leetcode.cn/problems/binary-tree-right-side-view/description/" class="link link-bold" target="_blank" rel="noopener noreferrer">199.二叉树的右视图</a>
			<p>起初采用了<a href="https://leetcode.cn/problems/vertical-order-traversal-of-a-binary-tree/description/" class="link link-bold" target="_blank" rel="noopener noreferrer">987.二叉树的垂序遍历</a>的做法，但是发现dfs垂序并不足以应对极端情况</p>
			<p>错误做法如下</p>
			<pre><code class="language-cpp">
class Solution {
public:
    vector&lt;int&gt; rightSideView(TreeNode* root) {
        vector&lt;int&gt; ans= {};
        vector&lt;tuple&lt;int, long long, int&gt;&gt; data;
        if(!root) return ans;
        auto dfs = [&](this auto&& dfs, TreeNode* node, int row, long long col) -> void{
            if(!node)return;
            data.emplace_back(row, col, node -> val);
            col *= 10;
            dfs(node -> left, row + 1, col - 1);
            dfs(node -> right, row + 1, col + 1);
        };
        dfs(root, 0, 0);
        ranges::sort(data);
        int last_row = 0;
        int value = root -> val;
        for(auto& [row, _, va]: data){
            if(row != last_row)ans.push_back(value);
            last_row = row;
            value = va;
        }
        ans.push_back(value);
        return ans;
    }
};

			</code></pre>
			<p>虽然也能通过大部分测试，但是在某些情况无法通过，这个思路使用BFS实现会更简单:</p>
			<h4>BFS</h4>
			<pre><code class="language-cpp">
class Solution {
public:
    vector&lt;int&gt; rightSideView(TreeNode* root) {
        vector&lt;int&gt; ans;
        if(!root)return ans;
        queue&lt;TreeNode*&gt; q;
        q.push(root);
        while(!q.empty()){
            int s = q.size();
            for(int i = 0; i < s; i++){
                TreeNode* node = q.front();
                q.pop();
                if(i == s - 1)ans.push_back(node -> val);
                if(node -> left)q.push(node -> left);
                if(node -> right)q.push(node -> right);
            }
        }
        return ans;
    }
};
			</code></pre>
			<h4>DFS</h4>
			<p>DFS则需要引入参数depth，根右左的顺序进行遍历</p>
			<pre><code class="language-cpp">
class Solution {
public:
    vector<int> rightSideView(TreeNode* root) {
        vector<int> ans;
        if(!root)return ans;
        auto dfs = [&](this auto&& dfs, TreeNode* node, int depth) -> void{
            if(!node)return;
            if(depth > ans.size())ans.push_back(node -> val);
            dfs(node -> right, depth + 1);
            dfs(node -> left, depth + 1);
        };
        dfs(root, 1);
        return ans;
    }
};
			</code></pre>

