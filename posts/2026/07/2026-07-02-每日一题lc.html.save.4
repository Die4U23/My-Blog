			<pre><code class="language- cpp">
class Solution {
public:
    bool isUnivalTree(TreeNode* root) {
        int value = root -> val;
        bool ans = true;
        auto dfs =[&](this auto&& dfs, TreeNode* node){
            if(!node)return;
            if(node -> val != value)ans = false;
            else{
                dfs(node -> left);
                dfs(node -> right);
            }
        };
        dfs(root);
        return ans;
    }
};
