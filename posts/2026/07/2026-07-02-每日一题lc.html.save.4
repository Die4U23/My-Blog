class Solution {
public:
    int sumNumbers(TreeNode* root) {
        int ans = 0;
        if(!root) return 0;
        auto dfs = [&](this auto && dfs, TreeNode* node, int s) -> void{
            if(!node)return;
            s = 10 * s + node -> val;
            if(!(node -> left) && !(node -> right))
            ans += s;
            else{
                dfs(node -> left, s);
                dfs(node -> right, s);
            }
        };
        dfs(root, 0);
        return ans;
    }
};
