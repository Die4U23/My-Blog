			<h3>951.翻转等价二叉树</h3>
			<a href="https://leetcode.cn/problems/flip-equivalent-binary-trees/description/" class="link link-bold" target="_blank" rel="noopener noreferrer">951.翻转等价二叉树</a>
			<p>采用哈希表记录父值，dfs简单做</p>
			<pre><code class="language-cpp">
class Solution {
public:
    bool flipEquiv(TreeNode* root1, TreeNode* root2) {
        if(!root1 || !root2)return !root1 && !root2;
        bool ans = true;
        std::unordered_map&lt;int, int&gt; map;
        auto dfs = [&](this auto&& dfs, TreeNode* node, bool state, int parent) -> void{
            if(!node)return;
            int value = node -> val;
            if(state)map.emplace(value, parent);
            else{
                auto it = map.find(value);
                if(it != map.end()){
                    if(it -> second != parent){
                        ans = false;
                        return;
                    }
                    map.erase(value);
                }
                else{
                    ans = false;
                    return;
                }
            }
            dfs(node -> left, state, value);
            dfs(node -> right, state, value);
        };
        dfs(root1, true, -1);
        dfs(root2, false, -1);
        if(ans && !map.empty())return false;
        return ans;
    }
};
			</code></pre>
			<p>递归更为简单</p>
			<pre><code class="language-cpp">
class Solution {
public:
    bool flipEquiv(TreeNode* root1, TreeNode* root2) {
        if(!root1 || !root2)return !root1 && !root2;
        if(root1 -> val != root2 -> val)return false;
        return (flipEquiv(root1 -> left, root2 -> left) && flipEquiv(root1 -> right, root2 -> right)) || (flipEquiv(root1 -> left, root2 -> right) && flipEquiv(root1 -> right, root2 -> left));
    }
};
			</code></pre>
			
			<h3>226.翻转二叉树</h3>
			<a href="https://leetcode.cn/problems/invert-binary-tree/description/" class="link link-bold" target="_blank" rel="noopener noreferrer">226.翻转二叉树</a>
			<p>DFS简单翻转</p>
			<pre><code class="language-cpp">
class Solution {
public:
    TreeNode* invertTree(TreeNode* root) {
        if(!root)return root;
        auto dfs =[&](this auto&& dfs, TreeNode* node) -> void{
            if(!node)return;
            dfs(node -> left);
            dfs(node -> right);
            TreeNode* temp = node -> right;
            node -> right = node -> left;
            node -> left = temp;
        };
        dfs(root);
        return root;
    }
};
