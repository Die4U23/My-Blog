			<h2>链表</h2>
			<p>有关指针链表一类的题目</p>
			<h3>237.删除链表中的节点</h3>
			<a href = "https://leetcode.cn/problems/delete-node-in-a-linked-list/description/" class="link link--bold" target="_blank" rel="noopener noreferrer">237.删除链表中的节点</a>
			<p>这题有点脑筋急转弯的感觉，只用改变值不用处理节点</p>
			
			<pre><code class="language-cpp">
class Solution {
public:
    void deleteNode(ListNode* node) {
        ListNode* nextNode = node -&gt; next;
        node -&gt; val = nextNode -&gt; val;
        node -&gt; next = nextNode -&gt; next;
        delete nextNode;
    }
};
			</code></pre>
			<h3>19.删除链表的倒数第N个节点</h3>
			<a href = "https://leetcode.cn/problems/remove-nth-node-from-end-of-list/description/" class="link link--bold" target = "_blank" rel ="noopener noreferrer"> 19.删除链表的倒数第N个节点</a>
			<p>双指针问题，处理边界条件加入了头节点</p>

			<pre><code class="language-cpp">
class Solution {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {
        int i = 0;
        ListNode dummy(0, head);
        ListNode* headNode = &dummy, *tailNode = &dummy;
        while(i < n){
            if(!headNode)return dummy.next;
            headNode = headNode -> next;
            i++;
        }
        while(headNode -> next){
            headNode = headNode -> next;
            tailNode = tailNode -> next;
        }
        ListNode* nxt = tailNode -> next;
        tailNode -> next = nxt -> next;
        delete nxt;
        return dummy.next;
    }
};
			</code></pre>

			<h3>83.删除排序链表中的重复元素</h3>
			<a href = "https://leetcode.cn/problems/remove-duplicates-from-sorted-list/description/" class="link link--bold" target="_blank" rel="noopener noreferrer">83.删除排序链表中的重复元素</a>
			<p>简单题</p>
			<pre><code class="language-cpp">
class Solution {
public:
    ListNode* deleteDuplicates(ListNode* head) {
        if(!head) return nullptr;
        ListNode* node = head;
        ListNode* nxt;
        while(node -> next){
            if(node -> val == node -> next -> val){
                nxt = node -> next;
                node -> next = nxt -> next;
                delete nxt;
            }
            else{
            node = node -> next;
            }
        }
        return head;
    }
};
			</code></pre>
			
			<h3>82.删除排序链表中的重复元素II</h3>
			<a href = "https://leetcode.cn/problems/remove-duplicates-from-sorted-list-ii/description/" class="link link--bold" target="_blank" rel="noopener noreferrer">82.删除排序链表中的重复元素II</a>
			<p>和83相似，不过这题的边界需要引入哨兵节点</p>
			<pre><code class="language-cpp">
class Solution {
public:
    ListNode* deleteDuplicates(ListNode* head) {
        if(!head) return nullptr;
        ListNode dummy(-101, head);
        ListNode* nxt;
        ListNode* cur = &dummy;
        int value;
        while(cur -> next && cur -> next -> next){
            if(cur -> next -> val == cur -> next -> next -> val){
                value = cur -> next -> val;
                while(cur -> next && cur -> next -> val == value){
                    nxt = cur -> next;
                    cur -> next = cur -> next -> next;
                    delete nxt;
                }
            }
            else{
                cur = cur -> next;
            }
        }
        return dummy.next;
    }
};
			</code></pre>
			
			<h3>203.移除链表元素</h3>
			<a href ="https://leetcode.cn/problems/remove-linked-list-elements/description/" class="link link-bold" target="_blank" rel="noopener noreferrer">203.移除链表元素</a>
			<p>简单题</p>
			<pre><code class="language-cpp">
class Solution {
public:
    ListNode* removeElements(ListNode* head, int val) {
        ListNode dummy(0, head);
        ListNode* cur = &dummy;
        ListNode* nxt;
        while(cur -> next){
            if(cur -> next -> val == val){
                nxt = cur -> next;
                cur -> next = nxt -> next;
                delete nxt;
            }
            else{
                cur = cur -> next;
            }
        }
        return dummy.next;
    }
};
			</code></pre>
			
			<h3>3217.从链表中移除在数组中存在的节点</h3>
			<a href="https://leetcode.cn/problems/delete-nodes-from-linked-list-present-in-array/description/" class="link link-bold" target="_blank" rel="noopener norefferer">3217.从链表中移除在数组中存在的节点</a>
			<p>利用哈希表检验是否在数组，释放裸指针会报错，猜测为LeetCode框架已自主释放</p>
			<pre><code class="language-cpp">
 #include &lt;unordered_set&gt;
class Solution {
public:
    ListNode* modifiedList(vector<int>& nums, ListNode* head) {
        if(!head) return nullptr;
        unordered_set<int> group;
        ListNode dummy(0, head);
        ListNode* cur = &dummy;
        ListNode* nxt;
        for(auto num : nums){
            group.insert(num);
        }
        while(cur -> next){
            if(group.find(cur -> next -> val) != group.end()){
                nxt = cur -> next;
                cur -> next = nxt -> next;
            }
            else{
                cur = cur -> next;
            }
        }
        return dummy.next;
    }
};
			</code></pre>

			<h3>2487.从链表中移除节点</h3>
			<a href="https://leetcode.cn/problems/remove-nodes-from-linked-list/description/" class="link link-bold" target="_blank" rel="noopener noreferrer">2487.从链表中移除节点</a>
			<p>逆序遍历可以用迭代解决，更简单</p>
			<pre><code class="language-cpp">
class Solution {
public:
    ListNode* removeNodes(ListNode* head) {
        if(!(head -> next))return head;
        ListNode* nxt = removeNodes(head -> next);
        if(nxt -> val > head -> val){
            return nxt;
        }
        head -> next = nxt;
        return head;
    }
};
			</code></pre>
			
			<h3>1669.合并两个链表</h3>
			<a href="https://leetcode.cn/problems/merge-in-between-linked-lists/description/" class="link link-bold" target="_blank" rel="noopener noreferrer">1669.合并两个链表</a>
			<p>这题只需想清楚边界条件即可</p>
			<pre><code class="language-cpp">
class Solution {
public:
    ListNode* mergeInBetween(ListNode* list1, int a, int b, ListNode* list2) {
        ListNode dummy(0, list1);
        ListNode* cur = &dummy;
        ListNode* temp = cur;
        ListNode* nxt;
        for(int i = 0; i < a; i++){
            temp = temp -> next;
        }
        cur = temp;
        temp = temp -> next;
        for(int i = a; i <= b; i++){
            nxt = temp;
            temp = temp -> next;
            delete nxt;
        }
        cur -> next = list2;
        while(cur -> next){
            cur = cur -> next;
        }
        cur -> next = temp;
        return dummy.next;
    }
};
			</code></pre>
			
		    <h2>二叉树</h2>
			<h3>104.二叉树的最大深度</h3>
			<a href="https://leetcode.cn/problems/maximum-depth-of-binary-tree/description/" class="link link-bold" target="_blank" rel="noopener noreferrer">104.二叉树的最大深度</a>
			<p>迭代就好了</p>
			<pre><code class="language-cpp">
class Solution {
public:
    int maxDepth(TreeNode* root) {
        if(!root)return 0;
        return 1 + max(maxDepth(root -> left), maxDepth(root -> right));
    }
};
			</code></pre>

			<h3>111.二叉树的最小深度</h3>
			<a href="https://leetcode.cn/problems/minimum-depth-of-binary-tree/description/" class="link link-bold" target="_blank" rel="noopener noreferrer">111.二叉树的最小深度</a>
			<p>与前一题类似</p>
			<pre><code class="language-cpp">
public:
    int minDepth(TreeNode* root) {
        if(!root)return 0;
        if(!(root -> left) && root -> right){
            return 1 + minDepth(root -> right);
        }
        else if(root -> left && !(root -> right)){
            return 1 + minDepth(root -> left);
        }
        else{
            return 1 + min(minDepth(root -> left), minDepth(root -> right));
        }
    }
};
			</code></pre>

